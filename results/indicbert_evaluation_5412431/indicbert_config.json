{
  "max_length": 128,
  "eval_batch_size": 32,
  "max_samples_per_task": null,
  "eval_dropout": 0.0,
  "evaluation": {
    "benchmarks": {
      "indicglue": {
        "fine_tuning": {
          "enabled": true,
          "split_strategy": "original",
          "num_epochs": 10,
          "learning_rate": 2e-05,
          "batch_size": 32,
          "weight_decay": 0.01,
          "dropout": 0.1,
          "freeze_base_model": true,
          "early_stopping": {
            "patience": 3,
            "metric": "accuracy",
            "mode": "max"
          }
        }
      }
    },
    "bootstrap_samples": 1000,
    "confidence_level": 0.95,
    "save_visualizations": true,
    "visualization_format": [
      "png",
      "html"
    ],
    "use_eval_cache": false
  }
}